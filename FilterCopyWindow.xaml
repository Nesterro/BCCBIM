<Window x:Class="BCCPlugIn.FilterCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BCCPlugIn"
        mc:Ignorable="d"
        Title="BIMBCC — Копирование фильтров видов" Height="720" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Dark WPF Theme Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#434346"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark ComboBox Template for High Contrast Header & Dropdown -->
        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" Background="#2D2D30" BorderBrush="#434346" BorderThickness="1" CornerRadius="3"/>
                <ContentPresenter Grid.Column="0" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="8,6,4,6" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <Path x:Name="Arrow" Grid.Column="1" Fill="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Margin="0,0,4,0"/>
                <ToggleButton x:Name="ToggleButton" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                              Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Grid.ColumnSpan="2" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}">
                    <Border x:Name="DropDownBorder" Background="#252526" BorderBrush="#434346" BorderThickness="1" Margin="0,2,0,0" CornerRadius="3">
                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#007ACC"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBox & ComboBoxItem High Contrast Styles -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="#C91414"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E51919"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#555555"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButtonStyle">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44444C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Main Content 2 Columns -->
            <RowDefinition Height="*"/>
            <!-- 2: Options & Settings -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Action Buttons Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="4" Padding="12,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#C91414" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="BIMBCC — Копирование фильтров видов" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Быстрый перенос фильтров и графических переопределений между видами и шаблонами видов" FontSize="11" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Main Content Two Columns -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Left: Source View & Filters (45%) -->
                <ColumnDefinition Width="45*"/>
                <ColumnDefinition Width="12"/>
                <!-- Right: Target Views (55%) -->
                <ColumnDefinition Width="55*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Source View & Filters -->
            <GroupBox Grid.Column="0" Header="1. Исходный вид или Шаблон">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Source Selector -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Выберите вид-источник:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="SourceViewComboBox" DisplayMemberPath="DisplayName" SelectionChanged="SourceViewComboBox_SelectionChanged"/>
                    </StackPanel>

                    <!-- Search Filter -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilterSearchTextBox" Grid.Column="0" TextChanged="FilterSearchTextBox_TextChanged" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="0" Text="🔍 Поиск фильтра..." Foreground="#888888" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FilterSearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Выделить все" Style="{StaticResource SecondaryButtonStyle}" Click="SelectAllFilters_Click" Margin="0,0,4,0"/>
                            <Button Content="Снять" Style="{StaticResource SecondaryButtonStyle}" Click="DeselectAllFilters_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Filter DataGrid -->
                    <DataGrid x:Name="FiltersDataGrid" Grid.Row="3" AutoGenerateColumns="False" 
                              Background="#2D2D30" RowBackground="#252526" AlternatingRowBackground="#2D2D30"
                              Foreground="#FFFFFF" BorderBrush="#3F3F46" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#3F3F46" HeadersVisibility="Column"
                              CanUserAddRows="False" SelectionMode="Extended">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#333337"/>
                                <Setter Property="Foreground" Value="#007ACC"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#3F3F46"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Click="FilterCheckBox_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Имя фильтра" Binding="{Binding FilterName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Переопределения" Binding="{Binding OverridesSummary}" Width="160" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <!-- RIGHT COLUMN: Target Views & Templates -->
            <GroupBox Grid.Column="2" Header="2. Целевые виды и Шаблоны видов">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- View Type Filter Bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Фильтр по типу:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ViewTypeCategoryComboBox" Width="200" SelectionChanged="ViewTypeCategoryComboBox_SelectionChanged">
                            <ComboBoxItem Content="Все типы видов" IsSelected="True"/>
                            <ComboBoxItem Content="Планы этажей"/>
                            <ComboBoxItem Content="3D виды"/>
                            <ComboBoxItem Content="Разрезы / Фасады"/>
                            <ComboBoxItem Content="Шаблоны видов"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Target Search & Select Buttons -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TargetSearchTextBox" Grid.Column="0" TextChanged="TargetSearchTextBox_TextChanged" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="0" Text="🔍 Поиск целевого вида или шаблона..." Foreground="#888888" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TargetSearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Выделить видимые" Style="{StaticResource SecondaryButtonStyle}" Click="SelectVisibleTargets_Click" Margin="0,0,4,0"/>
                            <Button Content="Снять" Style="{StaticResource SecondaryButtonStyle}" Click="DeselectAllTargets_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Filter CheckBox Option -->
                    <CheckBox x:Name="IncludeViewsWithTemplateCheckBox" Grid.Row="2" Content="Отображать виды с примененным шаблоном видов" IsChecked="True" Checked="IncludeViewsWithTemplateCheckBox_CheckedChanged" Unchecked="IncludeViewsWithTemplateCheckBox_CheckedChanged" Margin="0,0,0,6"/>

                    <!-- Target Views DataGrid -->
                    <DataGrid x:Name="TargetsDataGrid" Grid.Row="3" AutoGenerateColumns="False" 
                              Background="#2D2D30" RowBackground="#252526" AlternatingRowBackground="#2D2D30"
                              Foreground="#FFFFFF" BorderBrush="#3F3F46" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#3F3F46" HeadersVisibility="Column"
                              CanUserAddRows="False" SelectionMode="Extended">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#333337"/>
                                <Setter Property="Foreground" Value="#007ACC"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#3F3F46"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Click="TargetCheckBox_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Наименование вида / шаблона" Binding="{Binding ViewName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Группа видов" Binding="{Binding ViewTypeGroup}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Статус шаблона" Binding="{Binding TemplateStatusText}" Width="160" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 2. Options Bar -->
        <Border Grid.Row="2" Background="#252526" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <CheckBox x:Name="OverwriteExistingCheckBox" Content="Перезаписывать настройки при совпадении фильтра" IsChecked="True" Margin="0,0,20,0"/>
                <CheckBox x:Name="CopyToAppliedTemplatesCheckBox" Content="Применять к Шаблону вида (если вид с шаблоном)" IsChecked="True" Margin="0,0,20,0" ToolTip="Фильтр скопируется непосредственно в Шаблон вида, примененный к выбранному виду."/>
                <CheckBox x:Name="CopyGraphicOverridesCheckBox" Content="Копировать переопределения графики" IsChecked="True" Margin="0,0,20,0"/>
                <CheckBox x:Name="CopyVisibilityCheckBox" Content="Копировать видимость" IsChecked="True" Margin="0,0,20,0"/>
            </WrapPanel>
        </Border>

        <!-- 3. Bottom Action Bar -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusTextBlock" Grid.Column="0" Text="Готово к работе." VerticalAlignment="Center" Foreground="#AAAAAA"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopyButton" Content="Скопировать фильтры" Style="{StaticResource PrimaryButtonStyle}" Click="CopyButton_Click" Margin="0,0,10,0"/>
                <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click" Width="90"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
