<Window x:Class="BCCPlugIn.HeatLossWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMBCC | Модуль Теплопотери" 
        Height="580" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1A1A1A"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <!-- Focus Visual Style for High Contrast Accessibility -->
        <Style x:Key="WcagFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="#005FB8" StrokeThickness="2" StrokeDashArray="2 2" RadiusX="4" RadiusY="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary High Contrast Red Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C91414"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A50E0E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="BorderBrush" Value="#005FB8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#8A8A8A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#005FB8"/>
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Block -->
            <RowDefinition Height="*"/>
            <!-- Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <Border Grid.Row="0" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="BIMBCC" Foreground="#C91414" FontWeight="Bold" FontSize="18"/>
                <TextBlock Text=" | ТЕПЛОПОТЕРИ (МАРКИРОВКА ОГРАЖДЕНИЙ)" Foreground="#262626" FontWeight="SemiBold" FontSize="15" Margin="5,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content Container -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <!-- Space Selection Card -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Выбор пространств для обработки:" FontWeight="SemiBold" Foreground="#404040" Margin="0,0,0,8"/>
                        <RadioButton x:Name="ScopeAllRadio" Content="Все пространства в проекте" IsChecked="True" Margin="0,0,0,6" Checked="ScopeRadio_Changed"/>
                        <RadioButton x:Name="ScopeSelectionRadio" Content="Текущее выделение элементов" Margin="0,0,0,6" Checked="ScopeRadio_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <RadioButton x:Name="ScopeLevelRadio" Content="Пространства на уровне:" VerticalAlignment="Center" Margin="0,0,10,0" Checked="ScopeRadio_Changed"/>
                            <ComboBox x:Name="LevelComboBox" Width="220" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Linked Model Selection Card -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Связанная модель (АР / Конструкции):" FontWeight="SemiBold" Foreground="#404040" Margin="0,0,0,6"/>
                        <ComboBox x:Name="LinkComboBox"/>
                    </StackPanel>
                </Border>

                <!-- Cube Marker Family Selection Card -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Типоразмер кубика-маркера (Обобщенные модели):" FontWeight="SemiBold" Foreground="#404040" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CubeSymbolComboBox"/>
                    </StackPanel>
                </Border>

                <!-- Parameter Names Mapping Card -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Сопоставление параметров:" FontWeight="SemiBold" Foreground="#404040" Margin="0,0,0,8"/>

                        <TextBlock Text="Параметр обозначения в связанной модели:" Foreground="#666666" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="LinkedParamTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="ADSK_Обозначение" Margin="0,0,0,8"/>

                        <TextBlock Text="Параметр обозначения в кубике:" Foreground="#666666" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TargetDesigParamTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="ADSK_Обозначение" Margin="0,0,0,8"/>

                        <TextBlock Text="Параметр площади в кубике (м²):" Foreground="#666666" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TargetAreaParamTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="ADSK_Площадь" Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- Options -->
                <CheckBox x:Name="DeleteExistingCheckBox" IsChecked="True" Content="Удалить ранее расставленные кубики перед расчётом" Margin="2,0,0,6"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Width="100" HorizontalAlignment="Left" Click="Cancel_Click"/>
            <Button Grid.Column="1" Content="РАССТАВИТЬ КУБИКИ" Style="{StaticResource PrimaryButtonStyle}" Width="180" HorizontalAlignment="Right" Click="Run_Click"/>
        </Grid>
    </Grid>
</Window>
