<Window x:Class="BCCPlugIn.HeatLossWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMBCC | Теплопотери"
        Height="670" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1A1A1A"
        ResizeMode="NoResize">

    

        

        

        <Window.Resources>
        <!-- Common WPF Resource Keys -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C91414"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E01818"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505054"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FilterChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#434346"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#434346"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#434346"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernTreeViewStyle" TargetType="TreeView">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#434346"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Dark WPF High-Contrast Theme Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}"/>

        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" Background="#2D2D30" BorderBrush="#434346" BorderThickness="1" CornerRadius="3"/>
                <ContentPresenter Grid.Column="0" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="8,6,4,6" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <Path x:Name="Arrow" Grid.Column="1" Fill="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Margin="0,0,4,0"/>
                <ToggleButton x:Name="ToggleButton" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                              Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Grid.ColumnSpan="2" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}">
                    <Border x:Name="DropDownBorder" Background="#252526" BorderBrush="#434346" BorderThickness="1" Margin="0,2,0,0" CornerRadius="3">
                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D30"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Контент -->
            <RowDefinition Height="*"/>
            <!-- Кнопки -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Заголовок ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1"
                Padding="0,0,0,10" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="BIMBCC" Foreground="#C91414"
                           FontWeight="Bold" FontSize="18"/>
                <TextBlock Text=" | ТЕПЛОПОТЕРИ" Foreground="#262626"
                           FontWeight="SemiBold" FontSize="18" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Контент ───────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Инфо-строка -->
                <Border Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1"
                        CornerRadius="5" Padding="10,8" Margin="0,0,0,14">
                    <TextBlock x:Name="InfoTextBlock"
                               Text="Найдено помещений: —"
                               Foreground="#7A5C00" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Область расстановки -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Область расстановки:"
                                   FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,8"/>
                        <RadioButton x:Name="AllSpacesRadioButton" Content="🌐 Во всём проекте"
                                     IsChecked="True" GroupName="ScopeGroup" Margin="0,0,0,6" Checked="Scope_Checked"/>
                        <RadioButton x:Name="ActiveViewRadioButton" Content="👁️ Только на текущем виде"
                                     GroupName="ScopeGroup" Checked="Scope_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Семейство-кубик -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Семейство кубика (Обобщённая модель):"
                                   FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,6"/>
                        <ComboBox x:Name="FamilyComboBox"/>
                    </StackPanel>
                </Border>

                <!-- Температуры -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Температурные условия (°C):"
                                   FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Наружный воздух:" Foreground="#595959"
                                           Margin="0,0,0,4" FontSize="12"/>
                                <TextBox x:Name="TempOutsideTextBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="-28"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Внутренний воздух:" Foreground="#595959"
                                           Margin="0,0,0,4" FontSize="12"/>
                                <TextBox x:Name="TempInsideTextBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="20"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Типы конструкций -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Обрабатываемые конструкции:"
                                   FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,10"/>

                        <UniformGrid Columns="2" Rows="3">
                            <CheckBox x:Name="ExteriorWallsCheckBox" Content="🧱  Наружные стены"
                                      IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="InteriorWallsCheckBox" Content="🧱  Внутренние стены"
                                      IsChecked="False" Margin="0,0,0,8"/>
                            <CheckBox x:Name="FloorsCheckBox" Content="⬛  Перекрытия / полы"
                                      IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="DoorsCheckBox" Content="🚪  Двери"
                                      IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="WindowsCheckBox" Content="🪟  Окна"
                                      IsChecked="True"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Определение наружных/внутренних конструкций -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Определение наружных / внутренних конструкций:"
                                   FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,10"/>

                        <RadioButton x:Name="ExteriorDetectByParamRadioButton" 
                                     Content="🏷️ По параметру элементов (MN_Наружный / АР / КР)"
                                     IsChecked="True" GroupName="ExteriorDetectGroup" Margin="0,0,0,8"
                                     Checked="ExteriorDetect_Checked" Unchecked="ExteriorDetect_Checked"/>

                        <Border x:Name="ExteriorParamSettingsPanel" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="5" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Имя параметра:" VerticalAlignment="Center" Foreground="#595959" FontSize="12"/>
                                    <TextBox Grid.Column="1" x:Name="ExteriorParamNameTextBox" 
                                             Style="{StaticResource ModernTextBoxStyle}" Text="MN_Наружный"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Условие:" VerticalAlignment="Center" Foreground="#595959" FontSize="12"/>
                                    <ComboBox Grid.Column="1" x:Name="ExteriorParamConditionComboBox" 
                                              SelectionChanged="ExteriorParamCondition_SelectionChanged">
                                        <ComboBoxItem Content="Чекбокс включен (Да / 1)" IsSelected="True"/>
                                        <ComboBoxItem Content="Чекбокс выключен (Нет / 0)"/>
                                        <ComboBoxItem Content="Текст равен значению..."/>
                                        <ComboBoxItem Content="Текст содержит..."/>
                                        <ComboBoxItem Content="Параметр заполнен (не пустой)"/>
                                    </ComboBox>
                                </Grid>

                                <Grid x:Name="ExteriorParamValueRow" Margin="0,0,0,8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Значение:" VerticalAlignment="Center" Foreground="#595959" FontSize="12"/>
                                    <TextBox Grid.Column="1" x:Name="ExteriorParamValueTextBox" 
                                             Style="{StaticResource ModernTextBoxStyle}" Text="1"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Классификация:" VerticalAlignment="Center" Foreground="#595959" FontSize="12"/>
                                    <ComboBox Grid.Column="1" x:Name="ExteriorClassificationComboBox">
                                        <ComboBoxItem Content="Считать НАРУЖНОЙ (если выполнено)" IsSelected="True"/>
                                        <ComboBoxItem Content="Считать ВНУТРЕННЕЙ (если выполнено)"/>
                                    </ComboBox>
                                </Grid>

                                <CheckBox x:Name="ExteriorFallbackCheckBox" 
                                          Content="Если параметр не найден — определять автоматически" 
                                          IsChecked="True" Margin="0,2,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <RadioButton x:Name="ExteriorDetectAutoRadioButton" 
                                     Content="⚙️ Автоматически (по свойствам типа Revit и топологии)"
                                     GroupName="ExteriorDetectGroup"
                                     Checked="ExteriorDetect_Checked" Unchecked="ExteriorDetect_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Подсказка -->
                <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                        CornerRadius="5" Padding="10,8" Margin="0,0,0,4">
                    <TextBlock Foreground="#2E7D32" FontSize="12" TextWrapping="Wrap">
                        После расстановки в проекте появятся 18 параметров «BCC_HL_…»
                        и спецификация <Bold>«BIMBCC Теплопотери»</Bold>,
                        отсортированная по номеру и имени помещения.
                    </TextBlock>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Кнопки ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}"
                    Width="100" HorizontalAlignment="Left" Click="Cancel_Click"/>
            <Button Grid.Column="1" x:Name="RunButton"
                    Content="РАССТАВИТЬ" Style="{StaticResource PrimaryButtonStyle}"
                    Width="160" HorizontalAlignment="Right" Click="Run_Click"/>
        </Grid>
    </Grid>
</Window>
