<Window x:Class="BCCPlugIn.HeatLossWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMBCC | Теплопотери"
        Height="560" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1A1A1A"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Focus Visual (WCAG 2.4.7) -->
        <Style x:Key="WcagFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="#005FB8" StrokeThickness="2"
                                   StrokeDashArray="2 2" RadiusX="4" RadiusY="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C91414"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A50E0E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="BorderBrush" Value="#005FB8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#8A8A8A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#005FB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Контент -->
            <RowDefinition Height="*"/>
            <!-- Кнопки -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Заголовок ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1"
                Padding="0,0,0,10" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="BIMBCC" Foreground="#C91414"
                           FontWeight="Bold" FontSize="18"/>
                <TextBlock Text=" | ТЕПЛОПОТЕРИ" Foreground="#262626"
                           FontWeight="SemiBold" FontSize="18" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Контент ───────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Инфо-строка -->
                <Border Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1"
                        CornerRadius="5" Padding="10,8" Margin="0,0,0,14">
                    <TextBlock x:Name="InfoTextBlock"
                               Text="Найдено помещений: —"
                               Foreground="#7A5C00" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Область расстановки -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Область расстановки:"
                                   FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,8"/>
                        <RadioButton x:Name="AllSpacesRadioButton" Content="🌐 Во всём проекте"
                                     IsChecked="True" GroupName="ScopeGroup" Margin="0,0,0,6" Checked="Scope_Checked"/>
                        <RadioButton x:Name="ActiveViewRadioButton" Content="👁️ Только на текущем виде"
                                     GroupName="ScopeGroup" Checked="Scope_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Семейство-кубик -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Семейство кубика (Обобщённая модель):"
                                   FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,6"/>
                        <ComboBox x:Name="FamilyComboBox"/>
                    </StackPanel>
                </Border>

                <!-- Температуры -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Температурные условия (°C):"
                                   FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Наружный воздух:" Foreground="#595959"
                                           Margin="0,0,0,4" FontSize="12"/>
                                <TextBox x:Name="TempOutsideTextBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="-28"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Внутренний воздух:" Foreground="#595959"
                                           Margin="0,0,0,4" FontSize="12"/>
                                <TextBox x:Name="TempInsideTextBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="20"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Типы конструкций -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Обрабатываемые конструкции:"
                                   FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,10"/>

                        <UniformGrid Columns="2" Rows="2">
                            <CheckBox x:Name="WallsCheckBox" Content="🧱  Стены"
                                      IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="FloorsCheckBox" Content="⬛  Перекрытия / полы"
                                      IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="DoorsCheckBox" Content="🚪  Двери"
                                      IsChecked="True"/>
                            <CheckBox x:Name="WindowsCheckBox" Content="🪟  Окна"
                                      IsChecked="True"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Подсказка -->
                <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                        CornerRadius="5" Padding="10,8" Margin="0,0,0,4">
                    <TextBlock Foreground="#2E7D32" FontSize="12" TextWrapping="Wrap">
                        После расстановки в проекте появятся 18 параметров «BCC_HL_…»
                        и спецификация <Bold>«BIMBCC Теплопотери»</Bold>,
                        отсортированная по номеру и имени помещения.
                    </TextBlock>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Кнопки ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}"
                    Width="100" HorizontalAlignment="Left" Click="Cancel_Click"/>
            <Button Grid.Column="1" x:Name="RunButton"
                    Content="РАССТАВИТЬ" Style="{StaticResource PrimaryButtonStyle}"
                    Width="160" HorizontalAlignment="Right" Click="Run_Click"/>
        </Grid>
    </Grid>
</Window>
