<Window x:Class="BCCPlugIn.ViewIn3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMBCC — 3D подрезка" Height="320" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="BIMBCC — 3D подрезка по выделению" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Быстрое создание подрезанного 3D вида с настройкой отступа и видимости границ" FontSize="11" Foreground="#AAAAAA" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="6,0">
            <!-- Slider for padding -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Отступ границы подрезки:" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=PaddingSlider, StringFormat={}{0:F0} мм}" Foreground="#007ACC" FontWeight="Bold"/>
            </Grid>
            <Slider x:Name="PaddingSlider" Minimum="0" Maximum="5000" Value="500" SmallChange="100" LargeChange="500" TickFrequency="500" IsSnapToTickEnabled="False" Margin="0,0,0,16"/>

            <!-- Checkbox section box visible -->
            <CheckBox x:Name="ShowSectionBoxCheckBox" Content="Показывать Границы 3D вида (Section Box)" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,0,16"/>

            <!-- Interactive selection button -->
            <Button x:Name="PickElementsButton" Content="🔍 Выбрать элементы в модели" Padding="10,6" Background="#333337" Foreground="#FFFFFF" BorderBrush="#555555" BorderThickness="1" Click="PickElementsButton_Click" Cursor="Hand"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ApplyButton" Content="Применить 3D подрезку" Width="170" Padding="10,6" Background="#C91414" Foreground="#FFFFFF" FontWeight="Bold" Click="ApplyButton_Click" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Отмена" Width="90" Padding="10,6" Background="#333337" Foreground="#FFFFFF" BorderBrush="#555555" Click="CancelButton_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
