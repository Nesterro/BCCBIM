<Window x:Class="BCCPlugIn.FontReplacerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMBCC — Пакетная замена шрифтов и стилей текста" Height="580" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0"
        FontFamily="Segoe UI" FontSize="13">
        
    

        <Window.Resources>
        <!-- Dark WPF High-Contrast Theme Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#434346"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" Background="#2D2D30" BorderBrush="#434346" BorderThickness="1" CornerRadius="3"/>
                <ContentPresenter Grid.Column="0" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="8,6,4,6" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <Path x:Name="Arrow" Grid.Column="1" Fill="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Margin="0,0,4,0"/>
                <ToggleButton x:Name="ToggleButton" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                              Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Grid.ColumnSpan="2" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}">
                    <Border x:Name="DropDownBorder" Background="#252526" BorderBrush="#434346" BorderThickness="1" Margin="0,2,0,0" CornerRadius="3">
                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D30"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="BIMBCC — Комплексная замена шрифтов и свойств текста" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Пакетная обработка размеров, текста, аннотаций и спецификаций" FontSize="11" Foreground="#AAAAAA" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">
                <!-- Group 1: Targets -->
                <GroupBox Header="1. Где менять шрифт и свойства" Margin="0,0,0,12" Foreground="#007ACC" BorderBrush="#3F3F46" Padding="8">
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox x:Name="TargetDimensionsCheckBox" Content="Размерные стили" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,20,8"/>
                        <CheckBox x:Name="TargetTextNotesCheckBox" Content="Стили текста" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,20,8"/>
                        <CheckBox x:Name="TargetAnnotationsCheckBox" Content="Семейства типовых аннотаций" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,20,8"/>
                        <CheckBox x:Name="TargetSchedulesCheckBox" Content="Текст спецификаций" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,20,8"/>
                    </WrapPanel>
                </GroupBox>

                <!-- Group 2: Typography Settings -->
                <GroupBox Header="2. Параметры шрифта и оформления" Foreground="#007ACC" BorderBrush="#3F3F46" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Font Family -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Шрифт текста:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,4"/>
                        <ComboBox x:Name="FontsComboBox" Grid.Row="0" Grid.Column="1" Padding="6,4" Background="#2D2D30" Foreground="#FFFFFF" Margin="0,4"/>

                        <!-- Text Size -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Размер текста (мм):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,4"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBox x:Name="TextSizeTextBox" Width="100" Text="2.5" Padding="6,4" Background="#2D2D30" Foreground="#FFFFFF" BorderBrush="#434346"/>
                            <CheckBox x:Name="OverrideTextSizeCheckBox" Content="Применить ко всем" IsChecked="False" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>

                        <!-- Width Scale -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Коэффициент ширины:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,4"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBox x:Name="WidthScaleTextBox" Width="100" Text="1.0" Padding="6,4" Background="#2D2D30" Foreground="#FFFFFF" BorderBrush="#434346"/>
                            <CheckBox x:Name="OverrideWidthScaleCheckBox" Content="Применить ко всем" IsChecked="False" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>

                        <!-- Styling & Flags -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Стилизация:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,4"/>
                        <WrapPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <CheckBox x:Name="BoldCheckBox" Content="Полужирный (Bold)" Foreground="#FFFFFF" Margin="0,0,20,0"/>
                            <CheckBox x:Name="ItalicCheckBox" Content="Курсив (Italic)" Foreground="#FFFFFF" Margin="0,0,20,0"/>
                        </WrapPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ReplaceButton" Content="Применить шрифты" Width="170" Padding="10,6" Background="#C91414" Foreground="#FFFFFF" FontWeight="Bold" Click="ReplaceButton_Click" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Отмена" Width="90" Padding="10,6" Background="#333337" Foreground="#FFFFFF" BorderBrush="#555555" Click="CancelButton_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
