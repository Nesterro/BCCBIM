<Window x:Class="BCCPlugIn.PlaceByXyzWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMBCC | Расстановка по координатам XYZ" 
        Height="700" Width="580"
        MinHeight="580" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1A1A1A"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <!-- Focus Visual Style for WCAG 2.4.7 High Contrast Focus -->
        <Style x:Key="WcagFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="#005FB8" StrokeThickness="2" StrokeDashArray="2 2" RadiusX="4" RadiusY="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary High Contrast Button Style (#C91414) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C91414"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A50E0E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="BorderBrush" Value="#005FB8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#8A8A8A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#005FB8"/>
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Title Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <Border Grid.Row="0" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="BIMBCC" Foreground="#C91414" FontWeight="Bold" FontSize="18"/>
                <TextBlock Text=" | ИМПОРТ И РАССТАНОВКА ПО XYZ" Foreground="#262626" FontWeight="SemiBold" FontSize="18" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <!-- File Selection Section Card -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. Файл координат (CSV / TXT / AutoCAD GEO):" FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FilePathTextBox" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Обзор..." Style="{StaticResource SecondaryButtonStyle}" Width="90" Margin="8,0,0,0" Click="BrowseFile_Click"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Разделитель:" FontSize="11" Foreground="#595959" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SeparatorComboBox" SelectionChanged="SeparatorComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Точка с запятой (;)" Tag=";"/>
                                    <ComboBoxItem Content="Запятая (,)" Tag=","/>
                                    <ComboBoxItem Content="Табуляция (Tab)" Tag="	"/>
                                    <ComboBoxItem Content="Пробел (Space)" Tag=" "/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <CheckBox x:Name="HasHeaderCheckBox" IsChecked="True" Content="Пропустить первую строку (заголовок)" Click="HasHeaderCheckBox_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Family & Type Selection Section Card -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="2. Выбор семейства и типа в Revit:" FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,8"/>
                        
                        <TextBlock Text="Категория:" FontSize="11" Foreground="#595959" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CategoryComboBox" Margin="0,0,0,8" SelectionChanged="CategoryComboBox_SelectionChanged"/>

                        <TextBlock Text="Семейство:" FontSize="11" Foreground="#595959" Margin="0,0,0,4"/>
                        <ComboBox x:Name="FamilyComboBox" Margin="0,0,0,8" SelectionChanged="FamilyComboBox_SelectionChanged"/>

                        <TextBlock Text="Типоразмер:" FontSize="11" Foreground="#595959" Margin="0,0,0,4"/>
                        <ComboBox x:Name="SymbolComboBox" Margin="0,0,0,8"/>

                        <TextBlock Text="Уровень размещения:" FontSize="11" Foreground="#595959" Margin="0,0,0,4"/>
                        <ComboBox x:Name="LevelComboBox"/>
                    </StackPanel>
                </Border>

                <!-- Mapping & Offset Section Card -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="3. Сопоставление колонок и параметры:" FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Колонка X (мм):" FontSize="11" Foreground="#595959" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ColXComboBox"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Колонка Y (мм):" FontSize="11" Foreground="#595959" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ColYComboBox"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Колонка Z (мм):" FontSize="11" Foreground="#595959" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ColZComboBox"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Колонка Марка/ID:" FontSize="11" Foreground="#595959" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ColMarkComboBox"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Записывать марку в параметр:" FontSize="11" Foreground="#595959" Margin="0,0,0,4"/>
                                <ComboBox x:Name="TargetParamComboBox"/>
                            </StackPanel>
                        </Grid>

                        <!-- Offsets -->
                        <TextBlock Text="Смещение координат (мм):" FontSize="11" Foreground="#595959" Margin="0,4,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" x:Name="OffsetXTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="0"/>
                            <TextBox Grid.Column="2" x:Name="OffsetYTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="0"/>
                            <TextBox Grid.Column="4" x:Name="OffsetZTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Width="100" HorizontalAlignment="Left" Click="Cancel_Click"/>
            <Button Grid.Column="1" Content="РАССТАВИТЬ ЭЛЕМЕНТЫ" Style="{StaticResource PrimaryButtonStyle}" Width="210" HorizontalAlignment="Right" Click="Place_Click"/>
        </Grid>
    </Grid>
</Window>
