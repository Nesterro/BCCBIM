<Window x:Class="BCCPlugIn.OpeningsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMBCC | Задание на отверстия" 
        Height="580" Width="470"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1A1A1A"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <!-- Focus Visual Style for WCAG 2.4.7 High Contrast Focus -->
        <Style x:Key="WcagFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="#005FB8" StrokeThickness="2" StrokeDashArray="2 2" RadiusX="4" RadiusY="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary High Contrast Button Style (#C91414) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C91414"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A50E0E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="BorderBrush" Value="#005FB8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#8A8A8A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#005FB8"/>
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Block -->
            <RowDefinition Height="*"/>
            <!-- Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <Border Grid.Row="0" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="BIMBCC" Foreground="#C91414" FontWeight="Bold" FontSize="18"/>
                <TextBlock Text=" | ЗАДАНИЕ НА ОТВЕРСТИЯ" Foreground="#262626" FontWeight="SemiBold" FontSize="18" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content Block -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>
                <!-- Host Selection Card -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Пересекать конструкции:" FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="WallsCheckBox" IsChecked="True" Content="Стены" Margin="0,0,20,0"/>
                            <CheckBox x:Name="FloorsCheckBox" IsChecked="True" Content="Перекрытия"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Families & Clearance Card -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Wall Opening Family -->
                        <TextBlock Text="Семейство отверстия в стене:" FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,6"/>
                        <ComboBox x:Name="WallOpeningComboBox" Margin="0,0,0,12"/>

                        <!-- Floor Opening Family -->
                        <TextBlock Text="Семейство отверстия в перекрытии:" FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,6"/>
                        <ComboBox x:Name="FloorOpeningComboBox" Margin="0,0,0,12"/>

                        <!-- Spacing clearance -->
                        <TextBlock Text="Зазор на сторону (мм):" FontWeight="SemiBold" Foreground="#595959" Margin="0,0,0,6"/>
                        <TextBox x:Name="ClearanceTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="50"/>
                    </StackPanel>
                </Border>

                <!-- Parameters Mapping Card -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Имена параметров в семействе отверстий:" FontWeight="Bold" Foreground="#C91414" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ширина:" VerticalAlignment="Center" Foreground="#595959"/>
                            <TextBox Grid.Column="1" x:Name="WidthParamTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="Ширина"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Высота / Диаметр:" VerticalAlignment="Center" Foreground="#595959"/>
                            <TextBox Grid.Column="1" x:Name="HeightParamTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="Высота"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Глубина (Толщина):" VerticalAlignment="Center" Foreground="#595959"/>
                            <TextBox Grid.Column="1" x:Name="DepthParamTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="Толщина"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Width="100" HorizontalAlignment="Left" Click="Cancel_Click"/>
            <Button Grid.Column="1" Content="РАЗМЕСТИТЬ" Style="{StaticResource PrimaryButtonStyle}" Width="150" HorizontalAlignment="Right" Click="Run_Click"/>
        </Grid>
    </Grid>
</Window>
