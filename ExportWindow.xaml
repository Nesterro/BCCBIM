<Window x:Class="BCCPlugIn.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMBCC | Экспорт в PDF" 
        Height="820" Width="580"
        MinHeight="620" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1A1A1A"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <!-- WPF Converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Focus Visual Style for WCAG 2.4.7 High Contrast Focus -->
        <Style x:Key="WcagFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="#005FB8" StrokeThickness="2" StrokeDashArray="2 2" RadiusX="4" RadiusY="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary High Contrast Button Style (#C91414) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C91414"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A50E0E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary High Contrast Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="BorderBrush" Value="#005FB8"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#005FB8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C91414"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" FontWeight="SemiBold"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#A50E0E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#8A8A8A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#005FB8"/>
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ListBox Style -->
        <Style x:Key="ModernListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Title Header (Row 0) -->
            <RowDefinition Height="Auto"/>
            <!-- Sheet Set Selection (Row 1) -->
            <RowDefinition Height="Auto"/>
            <!-- Search Filter (Row 2) -->
            <RowDefinition Height="Auto"/>
            <!-- Sheet List (Row 3) - Expands to fill available vertical space -->
            <RowDefinition Height="*"/>
            <!-- Select All/None Actions (Row 4) -->
            <RowDefinition Height="Auto"/>
            <!-- Save Settings (Row 5) -->
            <RowDefinition Height="Auto"/>
            <!-- Action Buttons (Row 6) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <Border Grid.Row="0" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="BIMBCC" Foreground="#C91414" FontWeight="Bold" FontSize="18"/>
                <TextBlock Text=" | ЭКСПОРТ В PDF" Foreground="#262626" FontWeight="SemiBold" FontSize="18" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Sheet Set Selection -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Выбор набора:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1" x:Name="SheetSetComboBox" SelectionChanged="SheetSetComboBox_SelectionChanged"/>
        </Grid>

        <!-- Search Box -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTextBox" Style="{StaticResource ModernTextBoxStyle}" TextChanged="SearchTextBox_TextChanged"/>
            <!-- Placeholder -->
            <TextBlock IsHitTestVisible="False" Text="Поиск листов по номеру или имени..." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#888888">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Sheets List -->
        <ListBox Grid.Row="3" x:Name="SheetsListBox" Style="{StaticResource ModernListBoxStyle}" MinHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Click="CheckBox_Click">
                            <CheckBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="2"/>
                                </Style>
                            </CheckBox.Resources>
                        </CheckBox>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="#C91414"/>
                            <TextBlock Text=" - " Foreground="#595959"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FDF3F3"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FDE8E8"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Select All / None Link Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,0,10">
            <Button Content="Выбрать все" Style="{StaticResource LinkButtonStyle}" Click="SelectAll_Click"/>
            <TextBlock Text="|" Foreground="#CCCCCC" Margin="10,0"/>
            <Button Content="Снять выбор" Style="{StaticResource LinkButtonStyle}" Click="SelectNone_Click"/>
            <TextBlock x:Name="SelectedCountText" Text=" (выбрано: 0 из 0)" Foreground="#888888" Margin="5,0,0,0"/>
        </StackPanel>

        <!-- Settings (Printer + Output folder + Combine + Revit PDF settings) -->
        <Border Grid.Row="5" Background="#FAFAFA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <!-- Printer Selection -->
                <TextBlock Text="Выбор PDF-принтера:" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,4"/>
                <ComboBox x:Name="PrinterComboBox" Margin="0,0,0,8"/>

                <!-- Output Folder -->
                <TextBlock Text="Папка сохранения:" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderTextBox" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Обзор..." Style="{StaticResource SecondaryButtonStyle}" Width="75" Margin="8,0,0,0" VerticalAlignment="Center" Click="BrowseFolder_Click"/>
                </Grid>

                <!-- PDF Options -->
                <CheckBox x:Name="CombineCheckBox" IsChecked="True" Content="Объединить выбранные листы в один PDF файл" VerticalAlignment="Center">
                    <CheckBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="2"/>
                        </Style>
                    </CheckBox.Resources>
                </CheckBox>
                
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Имя файла:" VerticalAlignment="Center" Visibility="{Binding IsChecked, ElementName=CombineCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBox Grid.Column="1" x:Name="FileNameTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="ExportedSheets" Margin="8,0,0,0" Visibility="{Binding IsChecked, ElementName=CombineCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                    <CheckBox x:Name="CropMarginsCheckBox" IsChecked="True" Content="Обрезать пустые поля (Без полей)" VerticalAlignment="Center" Margin="0,3,0,0">
                        <CheckBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="2"/>
                            </Style>
                        </CheckBox.Resources>
                    </CheckBox>

                    <CheckBox x:Name="FixQuotesCheckBox" IsChecked="True" Content="Исправлять символы в PDF (кавычки «», градусы °)" VerticalAlignment="Center" Margin="0,4,0,0">
                        <CheckBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="2"/>
                            </Style>
                        </CheckBox.Resources>
                    </CheckBox>
                </StackPanel>

                <!-- Advanced Settings Section (Collapsible Expander) -->
                <Expander Header="Дополнительные настройки печати" Foreground="#555555" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0">
                    <Border BorderBrush="#EAEAEA" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Paper Format -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="Формат бумаги:" FontSize="11" Foreground="#555555" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PaperFormatComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="По размеру листа (Авто)"/>
                                    <ComboBoxItem Content="A0"/>
                                    <ComboBoxItem Content="A1"/>
                                    <ComboBoxItem Content="A2"/>
                                    <ComboBoxItem Content="A3"/>
                                    <ComboBoxItem Content="A4"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Page Orientation -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="Ориентация страницы:" FontSize="11" Foreground="#555555" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PageOrientationComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="Автоматически (Авто)"/>
                                    <ComboBoxItem Content="Книжная"/>
                                    <ComboBoxItem Content="Альбомная"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Color Depth -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Цветопередача:" FontSize="11" Foreground="#555555" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ColorDepthComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="Цветной"/>
                                    <ComboBoxItem Content="Полутона серого"/>
                                    <ComboBoxItem Content="Черно-белый"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Zoom Type -->
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Масштабирование:" FontSize="11" Foreground="#555555" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ZoomTypeComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="Вписать в лист"/>
                                    <ComboBoxItem Content="100% Масштаб"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Graphics Processing Type (Row 2) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                <TextBlock Text="Тип обработки графики:" FontSize="11" Foreground="#555555" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ProcessingTypeComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="Векторная (Быстрая, текст можно выделять)"/>
                                    <ComboBoxItem Content="Растровая (Решает проблему с кавычками и шрифтами)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Footer Action Buttons -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Close Button -->
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Width="100" HorizontalAlignment="Left" Click="Cancel_Click"/>
            <!-- Export Button with PDF logo icon -->
            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Width="150" HorizontalAlignment="Right" Click="Export_Click">
                <StackPanel Orientation="Horizontal">
                    <!-- SVG Document PDF Icon -->
                    <Path Data="M4,2 L14,2 L20,8 L20,20 C20,21.1 19.1,22 18,22 L4,22 C2.9,22 2,21.1 2,20 L2,4 C2,2.9 2.9,2 4,2 Z M13,3 L4,3 L4,21 L18,21 L18,9 L13,9 L13,3 Z" 
                          Fill="White" Width="12" Height="14" Stretch="Fill" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ЭКСПОРТ" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
