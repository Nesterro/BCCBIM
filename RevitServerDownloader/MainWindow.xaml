<Window x:Class="RevitServerDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RevitServerDownloader"
        Title="BIMBCC | Загрузчик моделей Revit Server" 
        Height="720" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1A1A1A"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <!-- Focus Visual Style for WCAG 2.4.7 High Contrast Focus -->
        <Style x:Key="WcagFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="#005FB8" StrokeThickness="2" StrokeDashArray="2 2" RadiusX="4" RadiusY="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Button Styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C91414"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A50E0E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="BorderBrush" Value="#005FB8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#888888"/>
                    <Setter Property="Background" Value="#F9F9F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C91414"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" FontWeight="SemiBold"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#A50E0E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#8A8A8A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#005FB8"/>
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeView Style -->
        <Style x:Key="ModernTreeViewStyle" TargetType="TreeView">
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
        </Style>

        <!-- ListBox Style -->
        <Style x:Key="ModernListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Title Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Connection Panel -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Revit Server Tool Settings -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Split View (Folders vs Models) -->
            <RowDefinition Height="*"/>
            <!-- 4: Destination Folder -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Console Logs -->
            <RowDefinition Height="100"/>
            <!-- 6: Progress Bar & Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <Border Grid.Row="0" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="BIMBCC" Foreground="#C91414" FontWeight="Bold" FontSize="18"/>
                <TextBlock Text=" | ЗАГРУЗЧИК МОДЕЛЕЙ REVIT SERVER" Foreground="#262626" FontWeight="SemiBold" FontSize="18" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Connection Panel Card -->
        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Адрес RS:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#595959" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="ServerAddressTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="127.0.0.1" VerticalAlignment="Center"/>
                
                <TextBlock Grid.Column="2" Text="Версия RS:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#595959" Margin="15,0,10,0"/>
                <ComboBox Grid.Column="3" x:Name="ServerVersionComboBox" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ComboBoxItem Content="2026"/>
                    <ComboBoxItem Content="2025"/>
                    <ComboBoxItem Content="2024" IsSelected="True"/>
                    <ComboBoxItem Content="2023"/>
                    <ComboBoxItem Content="2022"/>
                    <ComboBoxItem Content="2021"/>
                    <ComboBoxItem Content="2020"/>
                </ComboBox>
                
                <Button Grid.Column="4" x:Name="ConnectButton" Content="Подключиться" Style="{StaticResource PrimaryButtonStyle}" Height="30" Click="ConnectButton_Click"/>
            </Grid>
        </Border>

        <!-- Revit Server Tool Settings -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Путь к RevitServerTool:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="ToolPathTextBox" Style="{StaticResource ModernTextBoxStyle}" VerticalAlignment="Center"/>
                
                <Button Grid.Column="2" Content="Автопоиск" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="10,0,0,0" VerticalAlignment="Center" Click="AutoDetectTool_Click"/>
                <Button Grid.Column="3" Content="Обзор..." Style="{StaticResource SecondaryButtonStyle}" Width="80" Margin="10,0,0,0" VerticalAlignment="Center" Click="BrowseTool_Click"/>
            </Grid>
        </Border>

        <!-- Split View (Folders Tree vs Models List) -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <!-- Folders Tree View -->
                <ColumnDefinition Width="280"/>
                <!-- Splitter Spacer -->
                <ColumnDefinition Width="15"/>
                <!-- Models List View -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Folders Tree View -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Папки сервера:" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,4"/>
                <TreeView Grid.Row="1" x:Name="FoldersTreeView" Style="{StaticResource ModernTreeViewStyle}" SelectedItemChanged="FoldersTreeView_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type local:FolderViewModel}" ItemsSource="{Binding SubFolders}">
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <!-- Simple Folder Icon -->
                                <Path Data="M2,4 L2,18 C2,19.1 2.9,20 4,20 L20,20 C21.1,20 22,19.1 22,18 L22,6 C22,4.9 21.1,4 20,4 L12,4 L10,2 L4,2 C2.9,2 2,2.9 2,4 Z" 
                                      Fill="#FFD060" Width="14" Height="14" Stretch="Fill" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>

            <!-- RIGHT: Models List View -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Модели в выбранной папке:" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" x:Name="SelectionHelpersPanel" Visibility="Collapsed">
                        <Button Content="Выбрать все" Style="{StaticResource LinkButtonStyle}" Click="SelectAllModels_Click"/>
                        <TextBlock Text="|" Foreground="#CCCCCC" Margin="8,0"/>
                        <Button Content="Снять выбор" Style="{StaticResource LinkButtonStyle}" Click="SelectNoneModels_Click"/>
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1" x:Name="ModelsListBox" Style="{StaticResource ModernListBoxStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Click="ModelCheckBox_Click">
                                    <CheckBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="2"/>
                                        </Style>
                                    </CheckBox.Resources>
                                </CheckBox>
                                
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Revit Model Icon -->
                                    <Path Data="M4,2 C2.9,2 2,2.9 2,4 L2,20 C2,21.1 2.9,22 4,22 L18,22 C19.1,22 20,21.1 20,20 L20,8 L14,2 L4,2 Z M13,9 L13,3 L19,9 L13,9 Z" 
                                          Fill="#4A90E2" Width="12" Height="14" Stretch="Fill" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                
                                <TextBlock Grid.Column="2" Text="{Binding SizeFormatted}" Foreground="#888888" VerticalAlignment="Center" Margin="15,0,5,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FDF3F3"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FDE8E8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock Grid.Row="2" x:Name="SelectedSummaryTextBlock" Text="Выбрано моделей: 0" Foreground="#555555" Margin="2,6,0,0" FontSize="12"/>
            </Grid>
        </Grid>

        <!-- Destination Folder Selector -->
        <Border Grid.Row="4" Background="#FAFAFA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Сохранить в папку:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="DestinationFolderTextBox" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Обзор..." Style="{StaticResource SecondaryButtonStyle}" Width="85" Margin="10,0,0,0" VerticalAlignment="Center" Click="BrowseDestinationFolder_Click"/>
            </Grid>
        </Border>

        <!-- Console Logs -->
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Лог процесса:" FontWeight="SemiBold" Foreground="#555555" Margin="2,0,0,4"/>
            <TextBox Grid.Row="1" x:Name="LogTextBox" Background="#1E1E1E" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderBrush="#E0E0E0" BorderThickness="1"/>
        </Grid>

        <!-- Progress Bar & Actions -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Progress Status & Bar -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusTextBlock" Text="Ожидание подключения..." Foreground="#666666" FontSize="11" Margin="2,0,0,4"/>
                <ProgressBar x:Name="DownloadProgressBar" Height="14" Minimum="0" Maximum="100" Value="0" Background="#F0F0F0" BorderBrush="#E0E0E0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Name="Track" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"/>
                                <Border Name="Indicator" Background="#C91414" CornerRadius="3" HorizontalAlignment="Left" Width="{TemplateBinding Value}"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </StackPanel>

            <Button Grid.Column="1" x:Name="CancelButton" Content="Закрыть" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="36" VerticalAlignment="Bottom" Click="CancelButton_Click"/>
            <Button Grid.Column="3" x:Name="DownloadButton" Content="СКАЧАТЬ" Style="{StaticResource PrimaryButtonStyle}" Width="150" Height="36" VerticalAlignment="Bottom" Click="DownloadButton_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
