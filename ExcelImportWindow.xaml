<Window x:Class="BCCPlugIn.ExcelImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMBCC — Импорт данных из Excel" Height="420" Width="560"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="BIMBCC — Заполнение параметров элементов из Excel" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Импорт значений параметров из таблиц .xlsx в объекты модели Revit" FontSize="11" Foreground="#AAAAAA" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="6,0">
            <TextBlock Text="1. Выберите файл Excel (.xlsx):" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ExcelPathTextBox" Padding="6,4" Background="#2D2D30" Foreground="#FFFFFF" BorderBrush="#434346" IsReadOnly="True"/>
                <Button Grid.Column="1" Content="Обзор..." Padding="12,4" Background="#333337" Foreground="#FFFFFF" BorderBrush="#555555" Click="BrowseButton_Click" Margin="8,0,0,0" Cursor="Hand"/>
            </Grid>

            <TextBlock Text="2. Ключевой параметр идентификации элементов:" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="KeyParamComboBox" Background="#2D2D30" Foreground="#FFFFFF" Padding="6,4" Margin="0,0,0,16">
                <ComboBoxItem Content="Марка (Mark)" IsSelected="True"/>
                <ComboBoxItem Content="UniqueId"/>
                <ComboBoxItem Content="ElementId"/>
                <ComboBoxItem Content="Имя (Name)"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ImportButton" Content="Запустить импорт" Width="170" Padding="10,6" Background="#C91414" Foreground="#FFFFFF" FontWeight="Bold" Click="ImportButton_Click" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Отмена" Width="90" Padding="10,6" Background="#333337" Foreground="#FFFFFF" BorderBrush="#555555" Click="CancelButton_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
