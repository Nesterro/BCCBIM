<Window x:Class="BCCInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMBCC | Установочник плагина Revit" 
        Icon="installer_icon.ico"
        Height="600" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1A1A1A"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- Focus Visual Style for WCAG 2.4.7 High Contrast Focus -->
        <Style x:Key="WcagFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="#005FB8" StrokeThickness="2" StrokeDashArray="2 2" RadiusX="4" RadiusY="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style (#C91414) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C91414"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A50E0E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="BorderBrush" Value="#005FB8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource WcagFocusVisual}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Info Splitter -->
            <RowDefinition Height="*"/>
            <!-- Progress Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Footer Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="BIMBCC" Foreground="#C91414" FontWeight="Bold" FontSize="22"/>
                        <TextBlock Text=" | Мульти-версионная установка Revit" Foreground="#262626" FontWeight="SemiBold" FontSize="22" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Установка в %APPDATA% для Revit 2021, 2022, 2023, 2024, 2025 (без прав администратора)" Foreground="#595959" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Settings Button -->
                <Button Grid.Column="1" x:Name="SettingsButton" Content="⚙ Настройки GitHub" Style="{StaticResource SecondaryButtonStyle}" Padding="10,0" Click="Settings_Click"/>
            </Grid>
        </Border>

        <!-- Main Info Splitter -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- Status & Versions Panel -->
                <ColumnDefinition Width="290"/>
                <!-- Spacer -->
                <ColumnDefinition Width="16"/>
                <!-- Release Notes -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Status Cards Column -->
            <StackPanel Grid.Column="0">
                <!-- Status Box Card -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="СТАТУС УСТАНОВКИ" FontSize="11" FontWeight="Bold" Foreground="#595959" Margin="0,0,0,4"/>
                        <TextBlock x:Name="StatusTextBlock" Text="Проверка локальных файлов..." FontSize="13" FontWeight="Bold" Foreground="#C91414" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Version Comparison Box Card -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ВЕРСИИ ПЛАГИНА" FontSize="11" FontWeight="Bold" Foreground="#595959" Margin="0,0,0,6"/>
                        
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Установлена:" Foreground="#595959"/>
                            <TextBlock x:Name="InstalledVersionTextBlock" Text="..." FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid>
                            <TextBlock Text="Доступна на GitHub:" Foreground="#595959"/>
                            <TextBlock x:Name="OnlineVersionTextBlock" Text="..." Foreground="#C91414" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Target Revit Versions Selection Box Card -->
                <Border Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="ВЕРСИИ REVIT ДЛЯ РЕГИСТРАЦИИ" FontSize="11" FontWeight="Bold" Foreground="#595959" Margin="0,0,0,8"/>
                        
                        <WrapPanel x:Name="RevitVersionsWrapPanel" Orientation="Vertical">
                            <CheckBox x:Name="CbRevit2021" Content="Revit 2021" Margin="0,0,0,6"/>
                            <CheckBox x:Name="CbRevit2022" Content="Revit 2022" Margin="0,0,0,6"/>
                            <CheckBox x:Name="CbRevit2023" Content="Revit 2023" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox x:Name="CbRevit2024" Content="Revit 2024" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox x:Name="CbRevit2025" Content="Revit 2025" Margin="0,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Release Notes Column Card -->
            <Border Grid.Column="2" Background="#F8F9FA" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ОПИСАНИЕ ИЗМЕНЕНИЙ В РЕЛИЗЕ" FontSize="11" FontWeight="Bold" Foreground="#595959" Margin="0,0,0,8"/>
                    
                    <TextBox Grid.Row="1" x:Name="ReleaseNotesTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="White" BorderBrush="#D9D9D9" Padding="10" FontFamily="Segoe UI" FontSize="12" Foreground="#1A1A1A"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Progress Bar Bar -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock x:Name="ProgressStatusTextBlock" Text="Готов к работе" Foreground="#595959" FontSize="12" Margin="0,0,0,4"/>
            <ProgressBar x:Name="InstallProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#C91414"/>
        </StackPanel>

        <!-- Footer Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Uninstall Button -->
            <Button Grid.Column="0" x:Name="UninstallButton" Content="Удалить плагин" Style="{StaticResource SecondaryButtonStyle}" Width="140" Click="Uninstall_Click"/>

            <!-- Main Install/Update Button -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="CheckUpdatesButton" Content="🔄 Проверить" Style="{StaticResource SecondaryButtonStyle}" Width="130" Margin="0,0,10,0" Click="CheckUpdates_Click"/>
                <Button x:Name="InstallButton" Content="УСТАНОВИТЬ ПЛАГИН" Style="{StaticResource PrimaryButtonStyle}" Width="240" Click="Install_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
