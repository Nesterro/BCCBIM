<Window x:Class="BCCPlugIn.RenumberingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMBCC — Быстрая нумерация элементов" Height="360" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="BIMBCC — Нумерация помещений, дверей и оборудования" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Последовательное присвоение номеров выбранным элементам" FontSize="11" Foreground="#AAAAAA" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="6,0">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Префикс номера:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="PrefixTextBox" Grid.Column="1" Text="" Padding="6,4" Background="#2D2D30" Foreground="#FFFFFF" BorderBrush="#434346"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Начальный номер:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="StartNumTextBox" Grid.Column="1" Text="1" Padding="6,4" Background="#2D2D30" Foreground="#FFFFFF" BorderBrush="#434346"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RenumberButton" Content="Пронумеровать" Width="170" Padding="10,6" Background="#C91414" Foreground="#FFFFFF" FontWeight="Bold" Click="RenumberButton_Click" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Отмена" Width="90" Padding="10,6" Background="#333337" Foreground="#FFFFFF" BorderBrush="#555555" Click="CancelButton_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
